// Eval is temporary
// later on it should be



func fib(n: s32): s32
begin
    if n = 0 then return 0
    if n = 1 then return 1
    return fib(n - 1) + fib(n - 2)
end


func main(): s32
begin
    var fib_20: s32

    fib_20 := @eval(fib(20))
    
    print fib_20

    return 0
end


// call, compile time call
// register it as a compile time call


Typechecking compile time calls:
1. Has to be done in isolation


pseudocode:
eval(node)
    s64 result = bytecode.run_node(node)
    AstLiteral lit
    lit.type = node.type
    lit.value = result
    return lit



